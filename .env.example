# LLM Provider Configuration (Required only for Discovery phase)
LLM_PROVIDER=anthropic # anthropic | openai | gemini | mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Automation Target Configuration
TARGET_BASE_URL=http://localhost:3000
ALLOWED_DOMAINS=localhost,127.0.0.1

# Surface Execution Settings
HEADLESS=true
ACTION_TIMEOUT_MS=10000
SLOW_MO_MS=0

# Safety & Guardrails
RISK_CLASSIFICATION_ENABLED=true
AUTO_APPROVE_HIGH_RISK=false
REDACTION_ENABLED=true

# Escalation Settings
ESCALATION_TIMEOUT_MS=300000
